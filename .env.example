# Postgres connection string for the order data warehouse
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=

# Set to "false" only if your Postgres host doesn't support SSL.
# Defaults to SSL on with rejectUnauthorized:false (good for managed services).
DATABASE_SSL=true

# Secret used to sign the internal auth JWT (lib/auth.ts). Must match prod.
JWT_SECRET=

# Clerk (Google SSO). Get both from https://dashboard.clerk.com → API keys.
# Clerk only proves the Google identity; authorization still comes from
# employeeBase.employee via /api/auth/google-login.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
