# --- Hasura (data access) ---------------------------------------------------
# This app reads the order database through Hasura's run_sql admin API
# (no direct Postgres connection). The endpoint MUST be a Hasura instance
# connected to the order DB (db.badho.in) with source name "default".
# Endpoint looks like: https://<your-hasura-host>/v1/graphql
HASURA_GRAPHQL_ENDPOINT=
HASURA_ADMIN_SECRET=

# --- Auth -------------------------------------------------------------------
# Random string used to sign the internal login JWT. Any long random value.
JWT_SECRET=

# The shared password you type on the /login page to access the dashboard.
DASHBOARD_PASSWORD=
